#!/usr/bin/env python3
"""PreToolUse hook: refuse a change to the project until a declaration has routed the work.

Prints a deny decision with the reason when the gate is closed; prints nothing otherwise,
recording an allowed change in the session's ledger. Fails open (see seams_ledger.run_hook).
"""
import os
import sys

sys.dont_write_bytecode = True                 # no __pycache__ in the plugin directory
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import seams_gate as gate  # noqa: E402
import seams_ledger  # noqa: E402


def handle(event: dict):
    session = event.get("session_id") or ""
    ledger = seams_ledger.load_ledger(session)
    decision = gate.decide_pre_tool_use(event, ledger)
    if decision["decision"] == "deny":
        return {"hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": decision["reason"],
        }}
    if decision["change"]:
        seams_ledger.add_change(ledger, decision["change"])
        seams_ledger.save_ledger(session, ledger)
    return None

if __name__ == "__main__":
    sys.exit(seams_ledger.run_hook(handle))
