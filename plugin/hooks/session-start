#!/usr/bin/env python3
"""SessionStart hook for the matt-pocock-workflow plugin.

Injects the using-matt-pocock-skills bootstrap at startup, /clear and compaction, the way
Superpowers injects using-superpowers, so the routing policy is in context from turn one.

Reads the SessionStart event on stdin and prints {"hookSpecificOutput": {...}}: the bootstrap
body, with ${CLAUDE_PLUGIN_ROOT} replaced by the plugin's path so it can point at its own
reference files, then a "This session" section. That section says where Matt Pocock's skills
are installed (CLAUDE_CONFIG_DIR, else ~/.claude), or which required ones are missing and how
to install them, and nudges toward the foundations skill when the working repo has no
docs/agents/issue-tracker.md.
Also keeps the gate's ledger: a new session or /clear starts with an empty one.
Fails open (see seams_gate.run_hook). Python 3.9: macOS's system interpreter may run this.
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

sys.dont_write_bytecode = True                 # no __pycache__ in the plugin directory
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
try:
    import seams_gate as gate                  # the ledger; the bootstrap must inject without it
except Exception:                              # noqa: BLE001
    gate = None

HERE = Path(__file__).resolve().parent.parent
# The root Claude Code runs this plugin from. It supplies CLAUDE_PLUGIN_ROOT; for a plugin
# installed from a local directory that is the directory itself, not the cache copy, so the
# paths injected below must come from it. The hook's own location is only the fallback for
# direct runs (tests).
PLUGIN = Path(os.environ.get("CLAUDE_PLUGIN_ROOT") or HERE)
BOOTSTRAP = HERE / "skills" / "using-matt-pocock-skills" / "SKILL.md"

PREAMBLE = "Your `matt-pocock-workflow:using-matt-pocock-skills` skill, this session's routing policy:"
# The Matt Pocock skills the bootstrap and the Seams skills invoke with the Skill tool. The
# rest of his set (the standalone skills routing.md lists, his user-only commands) is only ever
# suggested to the user by name, so it is not checked. scripts/install.sh checks the same list and
# names the same install command (global, Claude Code only; without -g skills.sh installs into
# the current project); scripts/tests/test_install.sh keeps the two in step.
REQUIRED_SKILLS = ("grilling", "domain-modeling", "tdd", "diagnosing-bugs", "code-review",
                   "codebase-design", "setup-matt-pocock-skills", "setup-pre-commit",
                   "setup-ts-deep-modules")
ASK_TO_INSTALL = "ask the user to run `npx skills add mattpocock/skills -g -a claude-code` and restart."


def without_frontmatter(text: str) -> str:
    """The skill body: everything after the leading --- frontmatter block, if there is one."""
    if text.startswith("---\n"):
        end = text.find("\n---\n", 4)
        if end != -1:
            return text[end + len("\n---\n"):].strip()
    return text.strip()


def config_dir() -> Path:
    """Claude Code's config directory, resolved as the gate does: CLAUDE_CONFIG_DIR, else ~/.claude."""
    if gate is not None:
        return Path(gate.config_dir())
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"))


def mp_line(config: Path, repo: "Path | None" = None) -> str:
    """Where Matt Pocock's skills live, or which required ones are missing. Claude Code loads
    skills from the config directory and from the repo's own .claude/skills (skills.sh without
    -g, and what an eval run's scaffold provides), so both are looked at; a skill counts when
    either has it, and the line names the directory holding the most."""
    candidates = [config / "skills"] + ([repo / ".claude" / "skills"] if repo else [])
    present = {name for skills in candidates for name in REQUIRED_SKILLS if (skills / name / "SKILL.md").is_file()}
    missing = [name for name in REQUIRED_SKILLS if name not in present]
    skills = max(candidates, key=lambda d: sum((d / n / "SKILL.md").is_file() for n in REQUIRED_SKILLS))
    if not missing:
        return f"- Matt Pocock's skill files: `{skills}/<name>/SKILL.md`."
    if len(missing) == len(REQUIRED_SKILLS):
        return f"- Matt Pocock's skills are not installed at `{skills}`: {ASK_TO_INSTALL}"
    return f"- Matt Pocock's skills at `{skills}` are missing {', '.join(missing)}: {ASK_TO_INSTALL}"


def repo_root(start: Path) -> Path | None:
    """The nearest directory at or above `start` holding a .git entry (a repo or a worktree)."""
    for directory in (start, *start.parents):
        if (directory / ".git").exists():
            return directory
    return None


def setup_line(cwd: Path) -> str | None:
    """A nudge toward the foundations skill when the repo lacks MP's issue-tracker config."""
    root = repo_root(cwd)
    if root is None or (root / "docs" / "agents" / "issue-tracker.md").is_file():
        return None
    return "- No `docs/agents/issue-tracker.md` here: offer `matt-pocock-workflow:foundations` first."


def ledger_housekeeping(event: dict) -> None:
    """A new session or /clear starts with an empty ledger; compaction keeps it; old ones go."""
    if gate is None:
        return
    session = event.get("session_id") or ""
    if event.get("source") in ("startup", "clear"):
        gate.reset_ledger(session)
    gate.cleanup_ledgers()


def handle(event: dict) -> dict:
    try:
        ledger_housekeeping(event)
    except Exception:                          # the bootstrap still gets injected below
        import traceback
        traceback.print_exc(file=sys.stderr)
    cwd = Path(event.get("cwd") or os.getcwd())
    body = without_frontmatter(BOOTSTRAP.read_text()).replace("${CLAUDE_PLUGIN_ROOT}", str(PLUGIN))
    lines = (mp_line(config_dir(), repo_root(cwd)), setup_line(cwd))
    session = "## This session\n" + "\n".join(line for line in lines if line)
    context = ("<EXTREMELY_IMPORTANT>\n" + PREAMBLE + "\n\n" + body + "\n\n" + session
               + "\n</EXTREMELY_IMPORTANT>")
    return {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context}}


def main() -> int:
    if gate is not None:
        return gate.run_hook(handle)
    try:                                       # the same frame, without the module
        print(json.dumps(handle(json.loads(sys.stdin.read() or "{}"))))
    except Exception:
        import traceback
        traceback.print_exc(file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
