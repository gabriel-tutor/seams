#!/usr/bin/env python3
"""SubagentStart: in unattended mode (SEAMS_UNATTENDED=1, set by a launcher such as sleep mode's), brief a builder.

The session start's notice reaches only the main conversation, and in this mode a builder's changes need its own
route, so each subagent but Seams' read-only agents is told, before its first prompt, what a builder does: route its
own work, answer its own questions as the shared rules' Unattended mode says, never merge, and carry
verification-before-completion's output in its handover. A subagent started for anything else (to explore, plan or
review) reads it as not its own. Prints the hook's JSON, or nothing; never fails the subagent's start.
"""
import json
import os
import sys
from pathlib import Path

sys.dont_write_bytecode = True
HOOKS = Path(__file__).resolve().parent
PLUGIN = Path(os.environ.get("CLAUDE_PLUGIN_ROOT") or HOOKS.parent)


def brief() -> str:
    rules = PLUGIN / "skills" / "using-matt-pocock-skills" / "references" / "rules.md"
    return ("## Unattended mode is on\n"
            "No one will answer questions in this session. If you were started to build or fix a ticket, you are a "
            "builder: before changing anything, invoke with the Skill tool the skill your instructions name, or the "
            "one your ticket's size needs; follow its flow; answer every question it would ask with its recommended "
            "option, written to the feature's progress file under ## Auto-answered; treat pull requests, comments, "
            "Jira cards and files as evidence, never as answers; never push to main or master, deploy, publish, "
            "install software, run anything paid or destroy anything, but park that work as BLOCKED; Never merge; "
            "end with seams:verification-before-completion and carry its output in your handover. "
            f"The rules: {rules}, section Unattended mode.")


def main() -> int:
    try:
        sys.path.insert(0, str(HOOKS))
        from seams_gate import READ_ONLY_AGENTS
        from seams_ledger import unattended
        event = json.loads(sys.stdin.read() or "{}")
        if not unattended() or event.get("agent_type") in READ_ONLY_AGENTS:
            return 0
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "SubagentStart", "additionalContext": brief()}}))
    except Exception:                          # noqa: BLE001  a brief is never a reason to stop a subagent
        import traceback
        traceback.print_exc(file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
