#!/usr/bin/env python3
"""UserPromptSubmit hook: a new prompt starts a new request.

A short go-ahead ("yes", "ok, do that") or a notice Claude Code generated keeps the current
request. A prompt that typed a process skill starts a new request already declared: the skills
the UserPromptExpansion hook recorded for it, or the prompt's own leading slash command. Any
other prompt after a declared request gets the lapse hint as context, naming the declarations
that lapsed; it restores none of them. The prompt text itself is never stored. Fails open (see
seams_gate.run_hook).
"""
import os
import sys

sys.dont_write_bytecode = True                 # no __pycache__ in the plugin directory
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import seams_gate as gate  # noqa: E402


def handle(event: dict):
    session = event.get("session_id") or ""
    ledger = gate.load_ledger(session)
    outcome = gate.submit_prompt(event, ledger)
    if outcome["changed"]:
        gate.save_ledger(session, ledger)
    if outcome["context"]:
        return {"hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                                       "additionalContext": outcome["context"]}}
    return None

if __name__ == "__main__":
    sys.exit(gate.run_hook(handle))
