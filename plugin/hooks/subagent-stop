#!/usr/bin/env python3
"""SubagentStop hook, the handover check: in unattended mode a builder that changed the project hands back only after
code-review and verification ran since its last change (.scratch/overnight-full-flow). Asks as hook feedback, which
keeps the builder going, up to three times per change. Prints nothing otherwise, and never by day.
Fails open (see seams_ledger.run_hook)."""
import os
import sys

sys.dont_write_bytecode = True                 # no __pycache__ in the plugin directory
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import seams_ledger  # noqa: E402


def handle(event: dict):
    session = event.get("session_id") or ""
    ledger = seams_ledger.load_ledger(session)
    reason = seams_ledger.decide_subagent_stop(ledger, event)
    if reason:
        seams_ledger.save_ledger(session, ledger)     # the ask is counted, so a builder is asked a bounded number of times
        return {"hookSpecificOutput": {"hookEventName": "SubagentStop", "additionalContext": reason}}
    return None


if __name__ == "__main__":
    sys.exit(seams_ledger.run_hook(handle))
